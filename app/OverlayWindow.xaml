<Window x:Class="GameZh.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Width="820" Height="170" MinWidth="300" MinHeight="95">
    <Border x:Name="Surface" Background="#E51A222B" CornerRadius="10" BorderThickness="1" BorderBrush="#788C9A" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="OriginalText" Grid.Row="0" Foreground="#BED2DC" FontSize="17" TextWrapping="Wrap" MaxHeight="54" Margin="0,0,0,6"/>
            <TextBlock x:Name="TranslatedText" Grid.Row="1" Foreground="White" FontSize="25" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <primitives:Thumb x:Name="ResizeGrip" Grid.RowSpan="2" Width="21" Height="21"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                              Background="#80B8C7D3" DragDelta="ResizeGrip_DragDelta"/>
        </Grid>
    </Border>
</Window>
